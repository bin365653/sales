// 勤策 AI 销售作战台 V1.0 —— 数据模型
// 依据《V1.0工程实施计划-Z》§4 数据库设计
// 约定：主键 UUID v7；snake_case 物理表/列名；配置类数据只引用不可变 UUID。

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------- 用户与会话（T01 建表 users；sessions 随 T02 认证任务迁移） ----------

enum user_role {
  sales
  admin
}

enum user_status {
  active
  disabled
}

model User {
  id           String      @id @default(uuid(7)) @db.Uuid
  username     String      @unique @db.VarChar(64)
  passwordHash String      @map("password_hash") @db.VarChar(255)
  name         String      @db.VarChar(64)
  role         user_role   @default(sales)
  status       user_status @default(active)
  createdAt    DateTime    @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime    @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  sessions Session[]

  @@map("users")
}

// ---------- 会话（T02）：数据库会话，可服务端撤销 ----------
// Cookie 只存随机 token；库里存 SHA-256 哈希（实施计划 §4.2/§8.1）。
// 有效期 30 天滑动续期；登出/停用账号立即失效（校验时检查 revoked_at/expires_at 与用户状态）。

model Session {
  id        String    @id @default(uuid(7)) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  tokenHash String    @unique @map("token_hash") @db.VarChar(64)
  expiresAt DateTime  @map("expires_at") @db.Timestamptz(6)
  revokedAt DateTime? @map("revoked_at") @db.Timestamptz(6)
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@map("sessions")
}

// ---------- 审计日志（T02 建表并记录登录/登出/改密；查询界面随 T15） ----------
// 覆盖登录、导入确认、导出、配置修改、删除、密钥更新（实施计划 §4.2）。
// user_id 逻辑关联不加外键（§4.4，避免高频写入约束开销）；不记密钥与敏感明文。

model AuditLog {
  id         String   @id @default(uuid(7)) @db.Uuid
  userId     String?  @map("user_id") @db.Uuid
  action     String   @db.VarChar(64)
  objectType String?  @map("object_type") @db.VarChar(64)
  objectId   String?  @map("object_id") @db.Uuid
  detail     Json?    @db.JsonB
  ip         String?  @db.VarChar(64)
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([createdAt])
  @@index([userId, createdAt])
  @@index([action, createdAt])
  @@map("audit_logs")
}

// ---------- 客户阶段（K2：UUID + 语义锚点，开放全配置） ----------
// id：不可变 UUID，业务关联与统计一律引用 id。
// semanticKey：语义锚点，仅预置阶段持有、不可移除；自定义新增阶段为空。
//   指标口径锚定 semanticKey（qualified/booked_demo/quoted/won 等）而非名称。
// code/name/sortOrder/isActive：可由管理员修改；改名改码不破坏历史
//   （历史可读性由 lead_events.stage_snapshot 快照保障，随 T03 迁移）。
// 不可物理删除，只能停用（isActive=false）。

model LeadStage {
  id          String   @id @default(uuid(7)) @db.Uuid
  semanticKey String?  @unique @map("semantic_key") @db.VarChar(64)
  code        String   @unique @db.VarChar(64)
  name        String   @db.VarChar(64)
  sortOrder   Int      @map("sort_order")
  isActive    Boolean  @default(true) @map("is_active")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  leads Lead[]

  @@map("lead_stages")
}

// ---------- 线索字段定义（T03，实施计划 §4.2 / C12） ----------
// 同时管理内置字段（key = leads 物理列名，由 seed 幂等生成，可启停/排序）
// 与自定义字段（管理员通过 API 新建，key 由管理员指定且此后不可变）。
// 自定义字段值存 leads.custom_values（键为 key）；V1.0 自定义字段不参与筛选与统计。

enum lead_field_type {
  text
  number
  date
  single_select
}

model LeadFieldDef {
  id         String         @id @default(uuid(7)) @db.Uuid
  key        String         @unique @db.VarChar(64)
  label      String         @db.VarChar(64)
  type       lead_field_type
  options    Json?          @db.JsonB
  validation Json?          @db.JsonB
  isBuiltin  Boolean        @default(false) @map("is_builtin")
  isActive   Boolean        @default(true) @map("is_active")
  sortOrder  Int            @map("sort_order")
  createdAt  DateTime       @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt  DateTime       @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@index([isActive, sortOrder])
  @@map("lead_field_defs")
}

// ---------- 客户线索核心表（T03，实施计划 §4.3） ----------
// PRD §5.3 字段全集落为独立列（便于筛选/索引/导入映射），分四组：
// 基本信息 / 系统情况 / 采购情况 / 管理。
// 所有非必填字段允许为空（PRD：不得强迫销售填写虚假数据 → 空值可保存）。
// 核实状态：四个关键事实字段「值列 + 状态列」成对设计（§4.3），默认 unknown。
// data_version：乐观并发控制 + AI 输入数据版本号（PRD §5.5）。
// deleted_at：软删除标记，历史表（lead_events 等）永不物理删除（M1/C11）。

enum fact_status {
  unknown
  unverified
  confirmed
}

enum lead_priority {
  high
  mid
  low
}

model Lead {
  id           String        @id @default(uuid(7)) @db.Uuid
  // —— 基本信息（PRD §5.3）——
  name         String        @db.VarChar(128)
  city         String?       @db.VarChar(64)
  industry     String?       @db.VarChar(64)
  mainCategory String?       @map("main_category") @db.VarChar(128)
  contactName  String?       @map("contact_name") @db.VarChar(64)
  contactTitle String?       @map("contact_title") @db.VarChar(64)
  contactPhone String?       @map("contact_phone") @db.VarChar(32)
  source       String?       @db.VarChar(64)
  salesTeamSize Int?         @map("sales_team_size")
  revenueRange String?       @map("revenue_range") @db.VarChar(64)
  salesMode    String?       @map("sales_mode") @db.VarChar(64)
  // —— 系统情况 ——
  currentSystem        String?    @map("current_system") @db.VarChar(128)
  systemModules        String?    @map("system_modules") @db.VarChar(255)
  contractExpiry       DateTime?  @map("contract_expiry") @db.Date
  knownPains           String?    @map("known_pains") @db.Text
  consideringSwitch    Boolean?   @map("considering_switch")
  // —— 采购情况 ——
  hasClearDemand       Boolean?   @map("has_clear_demand")
  purchaseTime         String?    @map("purchase_time") @db.VarChar(64)
  budget               String?    @db.VarChar(64)
  decisionMaker        String?    @map("decision_maker") @db.VarChar(128)
  decisionProcess      String?    @map("decision_process") @db.VarChar(255)
  mainConcerns         String?    @map("main_concerns") @db.Text
  // —— 核实状态（未知/待核实/已确认，§4.3 四个关键事实字段）——
  currentSystemStatus  fact_status @default(unknown) @map("current_system_status")
  contractExpiryStatus fact_status @default(unknown) @map("contract_expiry_status")
  purchaseTimeStatus   fact_status @default(unknown) @map("purchase_time_status")
  decisionMakerStatus  fact_status @default(unknown) @map("decision_maker_status")
  // —— 管理组 ——
  stageId       String         @map("stage_id") @db.Uuid
  priority      lead_priority  @default(mid)
  ownerId       String         @map("owner_id") @db.Uuid
  lastContactAt DateTime?      @map("last_contact_at") @db.Timestamptz(6)
  nextContactAt DateTime?      @map("next_contact_at") @db.Timestamptz(6)
  remark        String?        @db.Text
  customValues  Json?          @map("custom_values") @db.JsonB
  dataVersion   Int            @default(1) @map("data_version")
  deletedAt     DateTime?      @map("deleted_at") @db.Timestamptz(6)
  createdAt     DateTime       @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt     DateTime       @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  stage  LeadStage  @relation(fields: [stageId], references: [id])
  events LeadEvent[]

  @@index([ownerId, deletedAt, stageId])
  @@index([ownerId, nextContactAt])
  @@index([stageId])
  @@map("leads")
}

// ---------- 线索事件（T03，实施计划 §4.2） ----------
// 阶段变更必须记录前后状态、时间、操作人（PRD §5.8）。
// stage_snapshot 保存变更当时的阶段编码/名称（含语义锚点），
// 阶段改名/改码后历史事件仍按当时快照可读，指标口径锚定 semanticKey 不受影响（K2/C02）。
// 事件表只追加、不修改、不删除；occurred_at 即业务发生时间。

enum lead_event_type {
  created
  imported
  updated
  stage_changed
  deleted
}

model LeadEvent {
  id            String         @id @default(uuid(7)) @db.Uuid
  leadId        String         @map("lead_id") @db.Uuid
  actorId       String?        @map("actor_id") @db.Uuid
  eventType     lead_event_type @map("event_type")
  fromStageId   String?        @map("from_stage_id") @db.Uuid
  toStageId     String?        @map("to_stage_id") @db.Uuid
  stageSnapshot Json?          @map("stage_snapshot") @db.JsonB
  detail        Json?          @db.JsonB
  occurredAt    DateTime       @default(now()) @map("occurred_at") @db.Timestamptz(6)

  lead Lead @relation(fields: [leadId], references: [id])

  @@index([leadId, occurredAt])
  @@map("lead_events")
}
