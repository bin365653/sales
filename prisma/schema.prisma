// 勤策 AI 销售作战台 V1.0 —— 数据模型
// 依据《V1.0工程实施计划-Z》§4 数据库设计
// 约定：主键 UUID v7；snake_case 物理表/列名；配置类数据只引用不可变 UUID。

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------- 用户与会话（T01 建表 users；sessions 随 T02 认证任务迁移） ----------

enum user_role {
  sales
  admin
}

enum user_status {
  active
  disabled
}

model User {
  id           String      @id @default(uuid(7)) @db.Uuid
  username     String      @unique @db.VarChar(64)
  passwordHash String      @map("password_hash") @db.VarChar(255)
  name         String      @db.VarChar(64)
  role         user_role   @default(sales)
  status       user_status @default(active)
  createdAt    DateTime    @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime    @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  sessions        Session[]
  workTimeEntries WorkTimeEntry[]
  experiments     Experiment[]

  @@map("users")
}

// ---------- 会话（T02）：数据库会话，可服务端撤销 ----------
// Cookie 只存随机 token；库里存 SHA-256 哈希（实施计划 §4.2/§8.1）。
// 有效期 30 天滑动续期；登出/停用账号立即失效（校验时检查 revoked_at/expires_at 与用户状态）。

model Session {
  id        String    @id @default(uuid(7)) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  tokenHash String    @unique @map("token_hash") @db.VarChar(64)
  expiresAt DateTime  @map("expires_at") @db.Timestamptz(6)
  revokedAt DateTime? @map("revoked_at") @db.Timestamptz(6)
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@map("sessions")
}

// ---------- 审计日志（T02 建表并记录登录/登出/改密；查询界面随 T15） ----------
// 覆盖登录、导入确认、导出、配置修改、删除、密钥更新（实施计划 §4.2）。
// user_id 逻辑关联不加外键（§4.4，避免高频写入约束开销）；不记密钥与敏感明文。

model AuditLog {
  id         String   @id @default(uuid(7)) @db.Uuid
  userId     String?  @map("user_id") @db.Uuid
  action     String   @db.VarChar(64)
  objectType String?  @map("object_type") @db.VarChar(64)
  objectId   String?  @map("object_id") @db.Uuid
  detail     Json?    @db.JsonB
  ip         String?  @db.VarChar(64)
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([createdAt])
  @@index([userId, createdAt])
  @@index([action, createdAt])
  @@map("audit_logs")
}

// ---------- 客户阶段（K2：UUID + 语义锚点，开放全配置） ----------
// id：不可变 UUID，业务关联与统计一律引用 id。
// semanticKey：语义锚点，仅预置阶段持有、不可移除；自定义新增阶段为空。
//   指标口径锚定 semanticKey（qualified/booked_demo/quoted/won 等）而非名称。
// code/name/sortOrder/isActive：可由管理员修改；改名改码不破坏历史
//   （历史可读性由 lead_events.stage_snapshot 快照保障，随 T03 迁移）。
// 不可物理删除，只能停用（isActive=false）。

model LeadStage {
  id          String   @id @default(uuid(7)) @db.Uuid
  semanticKey String?  @unique @map("semantic_key") @db.VarChar(64)
  code        String   @unique @db.VarChar(64)
  name        String   @db.VarChar(64)
  sortOrder   Int      @map("sort_order")
  isActive    Boolean  @default(true) @map("is_active")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  leads Lead[]
  experiments Experiment[]

  @@map("lead_stages")
}

// ---------- 线索字段定义（T03，实施计划 §4.2 / C12） ----------
// 同时管理内置字段（key = leads 物理列名，由 seed 幂等生成，可启停/排序）
// 与自定义字段（管理员通过 API 新建，key 由管理员指定且此后不可变）。
// 自定义字段值存 leads.custom_values（键为 key）；V1.0 自定义字段不参与筛选与统计。

enum lead_field_type {
  text
  number
  date
  single_select
}

model LeadFieldDef {
  id          String          @id @default(uuid(7)) @db.Uuid
  key         String          @unique @db.VarChar(64)
  label       String          @db.VarChar(64)
  type        lead_field_type
  options     Json?           @db.JsonB
  validation  Json?           @db.JsonB
  isBuiltin   Boolean         @default(false) @map("is_builtin")
  isActive    Boolean         @default(true) @map("is_active")
  // V2.0（T02，实施计划 §3.1）：该字段启用数据字典——新建/编辑/导入值必须
  // ∈ 字典启用值；存量非字典值可继续显示，编辑时须改选（不静默改写）。
  dictEnabled Boolean         @default(false) @map("dict_enabled")
  sortOrder   Int             @map("sort_order")
  createdAt   DateTime        @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime        @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@index([isActive, sortOrder])
  @@map("lead_field_defs")
}

// ---------- 数据字典（V2.0-T02，实施计划 §3.1 / 决策 D1 / D5） ----------
// 画像字典字段的值域：下拉选择来源；current_system 专用 meta.isNextGen
// 标记驱动「新一代手机开单」建议（4.7 人工确认流，建议必经确认原则9）。
// fieldKey 白名单 = src/lib/dict.ts DICT_FIELD_KEYS（12 个画像字段）；
// 删除仅提供停用（isActive=false，与阶段管理一致），无物理删除。
// 字典启用状态物化在 lead_field_defs.dict_enabled：字段存在 ≥1 启用值即启用，
// 由字典服务在每次写入后同步（T02 验收：启用后新建/编辑/导入值必须 ∈ 启用值）。

model DictEntry {
  id        String   @id @default(uuid(7)) @db.Uuid
  fieldKey  String   @map("field_key") @db.VarChar(64)
  value     String   @db.VarChar(128)
  meta      Json?    @db.JsonB
  sortOrder Int      @map("sort_order")
  isActive  Boolean  @default(true) @map("is_active")
  createdBy String   @map("created_by") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@unique([fieldKey, value])
  @@index([fieldKey, isActive, sortOrder])
  @@map("dict_entries")
}

// ---------- 字段核实元数据（V2.0-T01，实施计划 §3.1 五元组 + P2 四态） ----------
// 每个客户每个可核实字段一行（unique(lead_id, field_key)）：状态四态
// （unknown/unverified/stated/confirmed）+ 来源 + 核实人 + 核实时间 + 备注。
// 读取优先本表；V1.0 四个旧状态列同事务镜像（deprecated，读取兜底）。
// verified_by 逻辑关联 users（同 audit_logs 惯例，不加外键）。
// 值变化 → 状态自动置 unverified（修复 V1.0「值变状态不变」缺陷）并更新核实人/时间；
// 清空值 → unknown；历史不可变由 lead_events(updated.changed) 承担，本表只存现状。

model LeadFieldVerification {
  id         String              @id @default(uuid(7)) @db.Uuid
  leadId     String              @map("lead_id") @db.Uuid
  fieldKey   String              @map("field_key") @db.VarChar(64)
  status     fact_status         @default(unknown)
  source     verification_source @default(manual)
  verifiedBy String?             @map("verified_by") @db.Uuid
  verifiedAt DateTime?           @map("verified_at") @db.Timestamptz(6)
  note       String?             @db.VarChar(255)
  createdAt  DateTime            @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt  DateTime            @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  lead Lead @relation(fields: [leadId], references: [id], onDelete: Cascade)

  @@unique([leadId, fieldKey])
  @@index([leadId])
  @@map("lead_field_verifications")
}

// ---------- 客户线索核心表（T03，实施计划 §4.3） ----------
// PRD §5.3 字段全集落为独立列（便于筛选/索引/导入映射），分四组：
// 基本信息 / 系统情况 / 采购情况 / 管理。
// 所有非必填字段允许为空（PRD：不得强迫销售填写虚假数据 → 空值可保存）。
// 核实状态：四个关键事实字段「值列 + 状态列」成对设计（§4.3），默认 unknown。
// data_version：乐观并发控制 + AI 输入数据版本号（PRD §5.5）。
// deleted_at：软删除标记，历史表（lead_events 等）永不物理删除（M1/C11）。

// V2.0（P2）：新增 stated（客户自述待复核）——电话销售场景中客户自述即主要
// 证据来源；进入四象限的「确认」= confirmed 或 stated（口径 P3，V2-T04 固化）。
// V1.0 存量 confirmed 语义不变；四个旧状态列与本枚举同型，同步写（V2-T01）。
enum fact_status {
  unknown
  unverified
  stated
  confirmed
}

// V2.0 四象限（P1）：a=第一象限（在用新一代+有意愿）/ b=第二（在用新一代+无意愿）
// / c=第三（未用新一代+有意愿）/ d=第四（未用新一代+无意愿）。
// 由服务端按已确认双维计算（evaluateQuadrant，V2-T04），用户不可直填；
// null = 画像待完善（任一维度未确认，未知≠否）。
enum lead_quadrant {
  a
  b
  c
  d
}

// V2.0 画像完善度（P5）：按核实状态计算而非填写数量（迭代文档红线）。
enum profile_status {
  incomplete
  basic
  deep
}

// V2.0 核实元数据来源：manual=线索创建/编辑；import=导入确认；
// interaction=沟通「本次确认」；initial=迁移回填（V1.0 存量对账基线）。
enum verification_source {
  manual
  import
  interaction
  initial
}

enum lead_priority {
  high
  mid
  low
}

model Lead {
  id                   String        @id @default(uuid(7)) @db.Uuid
  // —— 基本信息（PRD §5.3）——
  name                 String        @db.VarChar(128)
  city                 String?       @db.VarChar(64)
  industry             String?       @db.VarChar(64)
  mainCategory         String?       @map("main_category") @db.VarChar(128)
  contactName          String?       @map("contact_name") @db.VarChar(64)
  contactTitle         String?       @map("contact_title") @db.VarChar(64)
  contactPhone         String?       @map("contact_phone") @db.VarChar(32)
  source               String?       @db.VarChar(64)
  salesTeamSize        Int?          @map("sales_team_size")
  revenueRange         String?       @map("revenue_range") @db.VarChar(64)
  salesMode            String?       @map("sales_mode") @db.VarChar(64)
  // —— 系统情况 ——
  currentSystem        String?       @map("current_system") @db.VarChar(128)
  systemModules        String?       @map("system_modules") @db.VarChar(255)
  contractExpiry       DateTime?     @map("contract_expiry") @db.Date
  knownPains           String?       @map("known_pains") @db.Text
  consideringSwitch    Boolean?      @map("considering_switch")
  // —— 采购情况 ——
  hasClearDemand       Boolean?      @map("has_clear_demand")
  purchaseTime         String?       @map("purchase_time") @db.VarChar(64)
  budget               String?       @db.VarChar(64)
  decisionMaker        String?       @map("decision_maker") @db.VarChar(128)
  decisionProcess      String?       @map("decision_process") @db.VarChar(255)
  mainConcerns         String?       @map("main_concerns") @db.Text
  // —— 核实状态（未知/待核实/已确认，§4.3 四个关键事实字段）——
  // V2.0：核实元数据主存储迁往 lead_field_verifications（四态 + 五元组），
  // 本组四列保留并同步写（优先级规则 / AI context / 详情徽章三处旧读取点不漂移），
  // 标记 deprecated，V2.x 后期下线。
  currentSystemStatus  fact_status   @default(unknown) @map("current_system_status")
  contractExpiryStatus fact_status   @default(unknown) @map("contract_expiry_status")
  purchaseTimeStatus   fact_status   @default(unknown) @map("purchase_time_status")
  decisionMakerStatus  fact_status   @default(unknown) @map("decision_maker_status")
  // —— V2.0 画像扩展（实施计划 §3.1，全部可空，存量行不受影响）——
  // 软件画像 / X 轴：是否新一代手机开单（null=未知；字典建议确认后写入，D1）
  nextGenMobileOrder   Boolean?      @map("next_gen_mobile_order")
  // 意愿画像 / Y 轴：是否愿意沟通了解勤策（null=未知）
  qinceInterest        Boolean?      @map("qince_interest")
  // 分类：服务端计算（evaluateQuadrant，V2-T04），PRD §四不允许用户填写
  quadrantCode         lead_quadrant? @map("quadrant_code")
  quadrantComputedAt   DateTime?     @map("quadrant_computed_at") @db.Timestamptz(6)
  // 完善度：服务端按核实状态维护（P5，V2-T04）
  profileStatus        profile_status? @map("profile_status")
  lastProfileVerifiedAt DateTime?    @map("last_profile_verified_at") @db.Timestamptz(6)
  softwareVersion      String?       @map("software_version") @db.VarChar(128)
  salesTeamScale       String?       @map("sales_team_scale") @db.VarChar(32)
  customerCount        Int?          @map("customer_count")
  businessMgmtMode     String?       @map("business_mgmt_mode") @db.VarChar(64)
  orderMgmtMode        String?       @map("order_mgmt_mode") @db.VarChar(64)
  deliveryMgmtMode     String?       @map("delivery_mgmt_mode") @db.VarChar(64)
  financeMgmtMode      String?       @map("finance_mgmt_mode") @db.VarChar(64)
  warehouseArea        String?       @map("warehouse_area") @db.VarChar(64)
  warehouseType        String?       @map("warehouse_type") @db.VarChar(32)
  pickerCount          Int?          @map("picker_count")
  purchaseIntent       String?       @map("purchase_intent") @db.VarChar(64)
  expressedNeeds       String?       @map("expressed_needs") @db.Text
  noInterestReason     String?       @map("no_interest_reason") @db.VarChar(255)
  isBossContact        Boolean?      @map("is_boss_contact")
  // —— 管理组 ——
  stageId              String        @map("stage_id") @db.Uuid
  priority             lead_priority @default(mid)
  ownerId              String        @map("owner_id") @db.Uuid
  lastContactAt        DateTime?     @map("last_contact_at") @db.Timestamptz(6)
  nextContactAt        DateTime?     @map("next_contact_at") @db.Timestamptz(6)
  remark               String?       @db.Text
  customValues         Json?         @map("custom_values") @db.JsonB
  dataVersion          Int           @default(1) @map("data_version")
  deletedAt            DateTime?     @map("deleted_at") @db.Timestamptz(6)
  createdAt            DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt            DateTime      @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  stage        LeadStage     @relation(fields: [stageId], references: [id])
  events       LeadEvent[]
  interactions Interaction[]
  tasks        Task[]
  aiRuns       AiRun[]
  experimentAssignments ExperimentAssignment[]
  fieldVerifications LeadFieldVerification[]

  @@index([ownerId, deletedAt, stageId])
  @@index([ownerId, nextContactAt])
  @@index([stageId])
  @@map("leads")
}

// ---------- 线索事件（T03，实施计划 §4.2） ----------
// 阶段变更必须记录前后状态、时间、操作人（PRD §5.8）。
// stage_snapshot 保存变更当时的阶段编码/名称（含语义锚点），
// 阶段改名/改码后历史事件仍按当时快照可读，指标口径锚定 semanticKey 不受影响（K2/C02）。
// 事件表只追加、不修改、不删除；occurred_at 即业务发生时间。

enum lead_event_type {
  created
  imported
  updated
  stage_changed
  deleted
  // V2.0（§3.3）：分类变化（quadrant 重算留痕，detail 含 from/to + basis 双维快照）；
  // 跟进计划重算（迭代二 recalcFollowUpPlan，本迁移先扩枚举，事件随迭代二写入）
  quadrant_changed
  plan_changed
}

model LeadEvent {
  id            String          @id @default(uuid(7)) @db.Uuid
  leadId        String          @map("lead_id") @db.Uuid
  actorId       String?         @map("actor_id") @db.Uuid
  eventType     lead_event_type @map("event_type")
  fromStageId   String?         @map("from_stage_id") @db.Uuid
  toStageId     String?         @map("to_stage_id") @db.Uuid
  stageSnapshot Json?           @map("stage_snapshot") @db.JsonB
  detail        Json?           @db.JsonB
  occurredAt    DateTime        @default(now()) @map("occurred_at") @db.Timestamptz(6)

  lead Lead @relation(fields: [leadId], references: [id])

  @@index([leadId, occurredAt])
  @@map("lead_events")
}

// ---------- 导入批次与行（T05，实施计划 §4.2 两阶段导入） ----------
// 两阶段：上传/映射/预览只写本组表（pending），确认（confirm）才写 leads。
// raw 保存解析后的原始单元格值；normalized 保存映射+校验后的入参值；
// errors 为行级错误（字段 + 中文原因），dup_type/dup_lead_id/dup_row_no 记录
// 重复检出结果（M2：手机号标准化精确 = exact；名称+城市 = fuzzy；含文件内重复）。
// decision 默认值由预览阶段写入（错误行/重复行 skip，有效行 create_new），确认时可覆盖。

enum import_status {
  pending
  confirmed
  canceled
}

enum import_dup_type {
  none
  exact
  fuzzy
}

enum import_decision {
  skip
  create_new
}

model ImportBatch {
  id          String        @id @default(uuid(7)) @db.Uuid
  userId      String        @map("user_id") @db.Uuid
  filename    String        @db.VarChar(255)
  fileHash    String        @map("file_hash") @db.VarChar(64)
  headers     Json?         @db.JsonB
  mapping     Json?         @db.JsonB
  status      import_status @default(pending)
  counts      Json?         @db.JsonB
  confirmedAt DateTime?     @map("confirmed_at") @db.Timestamptz(6)
  createdAt   DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime      @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  rows ImportRow[]

  @@index([userId, createdAt])
  @@map("import_batches")
}

model ImportRow {
  id         String          @id @default(uuid(7)) @db.Uuid
  batchId    String          @map("batch_id") @db.Uuid
  rowNo      Int             @map("row_no")
  raw        Json            @db.JsonB
  normalized Json?           @db.JsonB
  errors     Json?           @db.JsonB
  hasErrors  Boolean         @default(false) @map("has_errors")
  dupType    import_dup_type @default(none) @map("dup_type")
  dupLeadId  String?         @map("dup_lead_id") @db.Uuid
  dupRowNo   Int?            @map("dup_row_no")
  decision   import_decision @default(skip) @map("decision")

  batch ImportBatch @relation(fields: [batchId], references: [id], onDelete: Cascade)

  @@unique([batchId, rowNo])
  @@index([batchId, dupType])
  @@map("import_rows")
}

// ---------- 导出文件（T05） ----------
// GET /api/exports/:id/download 需要"创建与下载分离"，故生成物落库（bytea）。
// §4.2 的 17 张业务表未含此表：这是 §6 导出契约（按 id 下载 + 限流 + 审计）的
// 实现支撑表，非业务实体。内容 24 小时过期，创建新导出时惰性清理过期行。

model ExportFile {
  id          String   @id @default(uuid(7)) @db.Uuid
  userId      String   @map("user_id") @db.Uuid
  kind        String   @db.VarChar(16)
  format      String   @db.VarChar(8)
  filename    String   @db.VarChar(255)
  contentType String   @map("content_type") @db.VarChar(128)
  content     Bytes
  filters     Json?    @db.JsonB
  expiresAt   DateTime @map("expires_at") @db.Timestamptz(6)
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([userId, createdAt])
  @@index([expiresAt])
  @@map("export_files")
}

// ---------- 沟通记录（T06，实施计划 §4.2 interactions / PRD §5.6） ----------
// 只追加 + 修正留痕（M11/M1）：不提供删除；修正不改写原值，
// edit_audit 追加 {at, by, changed:{field:{from,to}}}（谁、何时、改了什么）。
// direction 为 §5.9 呼出指标来源（K5/C08）；effective 判定按 PRD 统一定义
// 在表单文案中固化（"获得有价值业务信息或明确下一步动作，仅接通不算"）。
// 可见性经线索归属判定（§4.4）：本表不存 owner 冗余列，读写一律 JOIN leads 过滤。

enum interaction_channel {
  phone
  wechat
  visit
  other
}

enum interaction_direction {
  outbound
  inbound
}

model Interaction {
  id                     String                @id @default(uuid(7)) @db.Uuid
  leadId                 String                @map("lead_id") @db.Uuid
  userId                 String                @map("user_id") @db.Uuid
  occurredAt             DateTime              @map("occurred_at") @db.Timestamptz(6)
  channel                interaction_channel
  direction              interaction_direction
  connected              Boolean
  effective              Boolean
  // —— 沟通结果（PRD §5.6，全部可空）——
  feedback               String?               @map("feedback") @db.Text
  confirmedPains         String?               @map("confirmed_pains") @db.Text
  currentSystemConfirmed String?               @map("current_system_confirmed") @db.VarChar(128)
  purchaseTimeConfirmed  String?               @map("purchase_time_confirmed") @db.VarChar(64)
  decisionMakerNote      String?               @map("decision_maker_note") @db.VarChar(255)
  objections             String?               @db.Text
  // —— 结论与下一步 ——
  nextAction             String?               @map("next_action") @db.VarChar(255)
  nextContactAt          DateTime?             @map("next_contact_at") @db.Timestamptz(6)
  isQualified            Boolean               @default(false) @map("is_qualified")
  demoBooked             Boolean               @default(false) @map("demo_booked")
  // —— AI 摘要草稿来源（T10，§7.1 摘要审核流）：保存时人工确认的草稿 run ——
  // 逻辑引用（同 audit_logs，不加外键）；AI 输出本身只存 ai_runs.output（K3），
  // 本列仅记录"该记录确认自哪个草稿"，使原始输出与最终记录可区分、可追溯。
  aiRunId                String?               @map("ai_run_id") @db.Uuid
  // —— 修正审计（M11）：追加式数组，不覆盖历史条目 ——
  editAudit              Json?                 @map("edit_audit") @db.JsonB
  createdAt              DateTime              @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt              DateTime              @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  lead Lead @relation(fields: [leadId], references: [id])
  task Task?

  @@index([leadId, occurredAt])
  @@map("interactions")
}

// ---------- 销售任务（T07，实施计划 §4.2 tasks / PRD §5.7） ----------
// 每项任务必须关联客户；assignee_id 记录任务归属人（创建时快照 = 线索负责人），
// created_by 记录创建者；可见性一律经线索归属判定（§4.4，读写都过 permissions 层）。
// 完成必须留 completed_at（验收项）；任务只可取消、不可删除（C11）。
// interaction_id：完成弹窗生成的沟通记录引用（UIUX P6"已完成任务显示完成时间
// 与当时填写的沟通记录链接"）；手工新建/取消的任务为空。

enum task_type {
  first_contact
  follow_up
  needs_diag
  online_demo
  offline_visit
  quote_follow
  revive
}

enum task_status {
  pending
  done
  canceled
}

model Task {
  id            String      @id @default(uuid(7)) @db.Uuid
  leadId        String      @map("lead_id") @db.Uuid
  assigneeId    String      @map("assignee_id") @db.Uuid
  createdBy     String      @map("created_by") @db.Uuid
  type          task_type
  title         String      @db.VarChar(128)
  dueAt         DateTime    @map("due_at") @db.Timestamptz(6)
  status        task_status @default(pending)
  remark        String?     @db.Text
  completedAt   DateTime?   @map("completed_at") @db.Timestamptz(6)
  interactionId String?     @unique @map("interaction_id") @db.Uuid
  createdAt     DateTime    @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt     DateTime    @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  lead        Lead        @relation(fields: [leadId], references: [id])
  interaction Interaction? @relation(fields: [interactionId], references: [id])

  @@index([assigneeId, status, dueAt])
  @@index([leadId, status, dueAt])
  @@map("tasks")
}

// ---------- AI 基础设施（T08，实施计划 §4.2 / §7 / PRD §6） ----------
// 模型配置：密钥 AES-256-GCM 密文落库（主密钥来自环境变量 APP_ENCRYPTION_KEY，
// 不进 Git、不进备份，§8.3）；任何 API 只返回 key_last4 与"已配置"，绝不回显明文。
// 多条配置 + 单条激活（is_active）实现"换 provider 仅改配置"（C05）。

model ModelConfig {
  id           String   @id @default(uuid(7)) @db.Uuid
  provider     String   @db.VarChar(64)
  baseUrl      String   @map("base_url") @db.VarChar(255)
  modelName    String   @map("model_name") @db.VarChar(128)
  apiKeyCipher String   @map("api_key_cipher") @db.VarChar(512)
  keyLast4     String   @map("key_last4") @db.VarChar(4)
  timeoutMs    Int      @default(30000) @map("timeout_ms")
  maxRetries   Int      @default(1) @map("max_retries")
  isActive     Boolean  @default(false) @map("is_active")
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  runs AiRun[]

  @@map("model_configs")
}

// 提示词模板与版本：版本只增不改（不可变、可追溯，ai_runs 记录具体版本，
// 历史可复现）。每种 run_type 恰好一个模板（Registry 按 run_type 唯一定位），
// 模板内 version 递增，"启用"即取最高版本。
model PromptTemplate {
  id        String   @id @default(uuid(7)) @db.Uuid
  name      String   @db.VarChar(64)
  runType   ai_run_type @map("run_type")
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  versions PromptVersion[]

  @@unique([runType])
  @@map("prompt_templates")
}

model PromptVersion {
  id           String   @id @default(uuid(7)) @db.Uuid
  templateId   String   @map("template_id") @db.Uuid
  version      Int
  content      String   @db.Text
  outputSchema Json?    @map("output_schema") @db.JsonB
  createdBy    String   @map("created_by") @db.Uuid
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  template PromptTemplate @relation(fields: [templateId], references: [id])
  runs     AiRun[]

  @@unique([templateId, version])
  @@map("prompt_versions")
}

// 每次调用全量留痕（PRD §5.5/§6.8）：输入快照（白名单字段，无联系方式/密钥）+
// data_version + 输出经校验后才写入 output + 状态/耗时/错误类型。
// status=pending 创建后异步执行（§7.2 单机异步 + 前端轮询，接口预留 status 平滑换队列）。
enum ai_run_type {
  analysis
  call_prep
  interaction_summary
}

enum ai_run_status {
  pending
  success
  failed
  timeout
  invalid_output
}

enum ai_error_type {
  timeout
  auth
  rate_limit
  provider
  invalid_output
}

model AiRun {
  id               String        @id @default(uuid(7)) @db.Uuid
  leadId           String        @map("lead_id") @db.Uuid
  userId           String        @map("user_id") @db.Uuid
  runType          ai_run_type   @map("run_type")
  modelConfigId    String        @map("model_config_id") @db.Uuid
  promptVersionId  String        @map("prompt_version_id") @db.Uuid
  inputSnapshot    Json          @map("input_snapshot") @db.JsonB
  inputDataVersion Int           @map("input_data_version")
  output           Json?
  status           ai_run_status @default(pending)
  errorType        ai_error_type? @map("error_type")
  errorMessage     String?       @map("error_message") @db.VarChar(512)
  durationMs       Int?          @map("duration_ms")
  retryOfId        String?       @map("retry_of_id") @db.Uuid
  createdAt        DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime      @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  lead          Lead           @relation(fields: [leadId], references: [id])
  modelConfig   ModelConfig    @relation(fields: [modelConfigId], references: [id])
  promptVersion PromptVersion  @relation(fields: [promptVersionId], references: [id])

  @@index([leadId, createdAt])
  @@index([userId, createdAt])
  @@map("ai_runs")
}

// ---------- 每日工时（T11，实施计划 §4.2 work_time_entries / K5 / C03） ----------
// "每小时有效沟通数"的分母来源（K5）：每人每日一条，unique(user_id, work_date)；
// 重复提交走 upsert 覆盖不报错（T11 验收项），未填报日期看板显示"—"而非 0（C03）。
// work_date 为纯日期列（@db.Date，按 UTC 日期存储，同 leads.contract_expiry 口径），
// 值即销售在上海日历（C13）下的工作日；hours 0–24、0.5 步进（UIUX §4.9），
// 范围/步进校验以后端为唯一事实源。hours=0 合法（"当天未工作"），
// 与"未填报"（无行，hours=null）区分；看板两者都显示"—"，语义无差。

model WorkTimeEntry {
  id        String   @id @default(uuid(7)) @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  workDate  DateTime @map("work_date") @db.Date
  hours     Decimal  @db.Decimal(4, 1)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, workDate])
  @@index([workDate])
  @@map("work_time_entries")
}

// ---------- 实验分组（T14，实施计划 §4.2 experiments / PRD §5.10 / M3、C04） ----------
// 生命周期：draft（可改配置）→ assign 执行随机分组 → running（配置冻结，仅可关闭）
// → closed（历史可查；常规组禁 AI 规则随关闭解除——T14 确认 UIUX P8 建议语义）。
// 分组结果固定不可改（C04）：配置列在 running 后一律不可写；分组明细只追加。

enum experiment_status {
  draft
  running
  closed
}

enum experiment_group {
  control
  assisted
}

model Experiment {
  id            String            @id @default(uuid(7)) @db.Uuid
  name          String            @db.VarChar(64)
  status        experiment_status @default(draft)
  // —— 圈选条件（与看板圈选同语义：来源/行业精确 + 阶段当前快照 + 负责人）——
  source        String?           @db.VarChar(64)
  industry      String?           @db.VarChar(64)
  stageId       String?           @map("stage_id") @db.Uuid
  ownerId       String?           @map("owner_id") @db.Uuid
  // AI 辅助组占比（10–90 整数百分比，默认 50，UIUX P8"可调 10–90"）
  assistedRatio Int               @default(50) @map("assisted_ratio")
  // 最小样本阈值（默认 50；任一组样本量 < 阈值 → "样本不足，暂不宜判断"，§5.10）
  minSampleSize Int               @default(50) @map("min_sample_size")
  // —— 执行分组留痕（M3：分组时间/规则/操作人；规则快照随每条 assignment 冗余）——
  assignedAt    DateTime?         @map("assigned_at") @db.Timestamptz(6)
  assignedBy    String?           @map("assigned_by") @db.Uuid
  assignedCount Int?              @map("assigned_count")
  closedAt      DateTime?         @map("closed_at") @db.Timestamptz(6)
  createdBy     String            @map("created_by") @db.Uuid
  createdAt     DateTime          @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt     DateTime          @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  assignments ExperimentAssignment[]
  // V2.0-T01 补声明：t14 迁移已存在的外键（RESTRICT，保护圈选条件引用的阶段/负责人
  // 不被物理删除）此前未在 schema 中声明，导致 migrate diff 误判为漂移欲删除；
  // 此处按库中实际约束补齐（onDelete: Restrict），无行为变化。
  stageLeadStage LeadStage? @relation(fields: [stageId], references: [id], onDelete: Restrict)
  ownerUser User? @relation(fields: [ownerId], references: [id], onDelete: Restrict)

  @@index([status, assignedAt])
  @@map("experiments")
}

// 分组明细（PRD §5.10 逐条留痕：分组 ID/时间/规则/客户画像快照）。
// lead_id 全局唯一——同一线索不可重复分组（T14 验收项；跨实验亦不可，避免
// 两组效果互相污染）；实验为管理员创建的全局数据，无 owner 冗余列。
// 指标计算经 leadId 直接聚合（含软删除客户——发生过就是发生过，与看板同口径）。

model ExperimentAssignment {
  id              String           @id @default(uuid(7)) @db.Uuid
  experimentId    String           @map("experiment_id") @db.Uuid
  leadId          String           @unique @map("lead_id") @db.Uuid
  group           experiment_group
  // 分组规则快照：圈选条件 + 分组比例 + 随机方式（"random"）+ 分组时间
  ruleSnapshot    Json?            @map("rule_snapshot") @db.JsonB
  // 客户基本画像快照（PRD §5.10"客户基本画像"：名称/城市/行业/来源/阶段等白名单）
  profileSnapshot Json?            @map("profile_snapshot") @db.JsonB
  assignedAt      DateTime         @map("assigned_at") @db.Timestamptz(6)
  assignedBy      String           @map("assigned_by") @db.Uuid

  experiment Experiment @relation(fields: [experimentId], references: [id])
  lead       Lead       @relation(fields: [leadId], references: [id])

  @@index([experimentId, group])
  @@map("experiment_assignments")
}
