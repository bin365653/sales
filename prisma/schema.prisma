// 勤策 AI 销售作战台 V1.0 —— 数据模型
// 依据《V1.0工程实施计划-Z》§4 数据库设计
// 约定：主键 UUID v7；snake_case 物理表/列名；配置类数据只引用不可变 UUID。

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------- 用户与会话（T01 建表 users；sessions 随 T02 认证任务迁移） ----------

enum user_role {
  sales
  admin
}

enum user_status {
  active
  disabled
}

model User {
  id           String      @id @default(uuid(7)) @db.Uuid
  username     String      @unique @db.VarChar(64)
  passwordHash String      @map("password_hash") @db.VarChar(255)
  name         String      @db.VarChar(64)
  role         user_role   @default(sales)
  status       user_status @default(active)
  createdAt    DateTime    @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime    @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  sessions Session[]

  @@map("users")
}

// ---------- 会话（T02）：数据库会话，可服务端撤销 ----------
// Cookie 只存随机 token；库里存 SHA-256 哈希（实施计划 §4.2/§8.1）。
// 有效期 30 天滑动续期；登出/停用账号立即失效（校验时检查 revoked_at/expires_at 与用户状态）。

model Session {
  id        String    @id @default(uuid(7)) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  tokenHash String    @unique @map("token_hash") @db.VarChar(64)
  expiresAt DateTime  @map("expires_at") @db.Timestamptz(6)
  revokedAt DateTime? @map("revoked_at") @db.Timestamptz(6)
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@map("sessions")
}

// ---------- 审计日志（T02 建表并记录登录/登出/改密；查询界面随 T15） ----------
// 覆盖登录、导入确认、导出、配置修改、删除、密钥更新（实施计划 §4.2）。
// user_id 逻辑关联不加外键（§4.4，避免高频写入约束开销）；不记密钥与敏感明文。

model AuditLog {
  id         String   @id @default(uuid(7)) @db.Uuid
  userId     String?  @map("user_id") @db.Uuid
  action     String   @db.VarChar(64)
  objectType String?  @map("object_type") @db.VarChar(64)
  objectId   String?  @map("object_id") @db.Uuid
  detail     Json?    @db.JsonB
  ip         String?  @db.VarChar(64)
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([createdAt])
  @@index([userId, createdAt])
  @@index([action, createdAt])
  @@map("audit_logs")
}

// ---------- 客户阶段（K2：UUID + 语义锚点，开放全配置） ----------
// id：不可变 UUID，业务关联与统计一律引用 id。
// semanticKey：语义锚点，仅预置阶段持有、不可移除；自定义新增阶段为空。
//   指标口径锚定 semanticKey（qualified/booked_demo/quoted/won 等）而非名称。
// code/name/sortOrder/isActive：可由管理员修改；改名改码不破坏历史
//   （历史可读性由 lead_events.stage_snapshot 快照保障，随 T03 迁移）。
// 不可物理删除，只能停用（isActive=false）。

model LeadStage {
  id          String   @id @default(uuid(7)) @db.Uuid
  semanticKey String?  @unique @map("semantic_key") @db.VarChar(64)
  code        String   @unique @db.VarChar(64)
  name        String   @db.VarChar(64)
  sortOrder   Int      @map("sort_order")
  isActive    Boolean  @default(true) @map("is_active")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@map("lead_stages")
}
