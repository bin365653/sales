# 勤策 AI 销售作战台 —— Nginx 反向代理 + HTTPS 配置示例（T17，实施计划 §8.5）
# 用法：复制到 /etc/nginx/sites-available/qince.conf（或 conf.d/），按 <> 标注修改，
#   ln -s 到 sites-enabled 后 nginx -t && systemctl reload nginx。
# 证书签发见 docs/deploy.md「HTTPS（certbot）」。
#
# ===== 与应用安全机制强耦合的三处（T16 交接约定，勿删）=====
# 1. X-Forwarded-Host：Origin 校验（CSRF 防线 0）按"Origin 的主机 == 转发主机"判定，
#    不透传会导致同源写请求被 403 origin_forbidden。
# 2. X-Forwarded-For / X-Real-IP：登录/导出限流按 IP 计数、审计记录来源 IP。
# 3. client_max_body_size 必须 ≥ 11m：应用上传三限为 10MB（Next.js middleware 对
#    请求体有 10MB 硬截断，超限由应用返回业务 400 file_too_large）；nginx 默认 1m
#    会在应用之前拦掉，导致合法的 9MB 文件也传不上去、超限响应不是业务错误码。

server {
    listen 80;
    listen [::]:80;
    server_name <你的域名>;
    # certbot webroot 续期路径保留；其余全部 301 到 HTTPS
    location /.well-known/acme-challenge/ { root /var/www/certbot; }
    location / { return 301 https://$host$request_uri; }
}

server {
    listen 443 ssl;
    listen [::]:443 ssl;
    http2 on;
    server_name <你的域名>;

    ssl_certificate     /etc/letsencrypt/live/<你的域名>/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/<你的域名>/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_prefer_server_ciphers off;
    ssl_session_timeout 1d;
    ssl_session_cache shared:qince_ssl:10m;

    # HSTS：确认 HTTPS 稳定运行后再开启（先注释观察一周）
    # add_header Strict-Transport-Security "max-age=31536000" always;

    server_tokens off;
    client_max_body_size 11m;   # 见头部说明 3；不要低于 11m、也不必远大于它

    location / {
        proxy_pass http://127.0.0.1:3000;   # 生产 compose 只把 app 绑定在宿主机回环
        proxy_http_version 1.1;
        proxy_set_header Host $host;               # Origin 校验的对照基准
        proxy_set_header X-Forwarded-Host $host;   # 见头部说明 1（勿删）
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;  # 说明 2（勿删）
        proxy_set_header X-Real-IP $remote_addr;   # 说明 2（勿删）
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header Upgrade $http_upgrade;    # 预留（V1.0 无 WebSocket，无害）
        proxy_set_header Connection "upgrade";
        proxy_read_timeout 65s;   # 页面/API 均为短请求（AI 走发起-轮询，不挂长连接）
        proxy_send_timeout 65s;
    }
}
