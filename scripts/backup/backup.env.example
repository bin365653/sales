# 备份配置样例（T17，实施计划 §8.4）
# 复制为同目录 backup.env 后按部署环境填写；backup.env 不入 Git（.gitignore）。
# 所有条目均可留空 = 使用默认值或跳过对应环节（未配置加密/异地上传时脚本会
# 显式 WARN 并在日志中记录，绝不静默降级）。

# ---- 备份来源（二选一）----
# container：经 docker compose exec 在 postgres 容器内执行 pg_dump（云端生产/一键整栈）
# host     ：直接调用宿主机 pg_dump 二进制（无 Docker 部署、独立环境恢复演练）
PG_MODE=container

# container 模式参数（与 docker-compose*.yml 对齐）
COMPOSE_PROJECT_DIR=            # 默认仓库根目录
COMPOSE_FILES=docker-compose.yml # 生产用 docker-compose.prod.yml，多文件空格分隔
POSTGRES_SERVICE=postgres
POSTGRES_USER=qince
POSTGRES_DB=qince_sales

# host 模式参数（PGPASSWORD 建议写入 backup.env 而非命令行）
PGHOST=127.0.0.1
PGPORT=5432
PGDATABASE=qince_sales
PGUSER=qince
PGPASSWORD=
PG_DUMP_BIN=pg_dump             # 宿主机 pg_dump 绝对路径（大版本须 ≥ 服务端）

# ---- 备份产物 ----
BACKUP_DIR=                     # 默认 <仓库根>/backups（建议部署时指向宿主机数据盘独立目录）
BACKUP_KEEP_LOCAL=7             # 本地保留份数（§8.4：每日全量，保留 7 份）

# ---- age 加密（§8.4：备份落盘前加密；主密钥/密钥对与备份分离存放）----
# 生成密钥对：age-keygen -o age-identity.txt（私钥务必离线另存，不与备份同处）
# 此处填公钥（age1... 开头）后，备份自动加密为 .age 文件并删除明文
AGE_BIN=age                     # age 可执行文件路径或 PATH 内命令名
BACKUP_AGE_RECIPIENT=           # 空 = 不加密（仅限本地 MVP 初期，日志会 WARN）
BACKUP_AGE_IDENTITY_FILE=       # 私钥文件路径；配置后 restore.sh 可解密、备份后可做解密自检

# ---- 异地上传（§8.4：云端部署时经 rclone 上传对象存储，保留 4 周；本地 MVP 留空）----
# 预先 rclone config 建好远端（如 qince-obs:qince-backups）
RCLONE_BIN=rclone
RCLONE_REMOTE=                  # 空 = 不上传
BACKUP_KEEP_REMOTE=28           # 远端保留天数（4 周）

# ---- 失败邮件告警（§8.4：备份失败经 SMTP 发邮件；成功只写日志不发信）----
# SMTP 账号列入部署前准备清单（docs/deploy.md §准备清单）
# SMTP_URL 示例：smtps://smtp.example.com:465 或 smtp://smtp.example.com:587（587 自动 STARTTLS）
SMTP_URL=
SMTP_USER=
SMTP_PASS=
ALERT_FROM=qince-backup@example.com
ALERT_TO=ops@example.com
ALERT_SUBJECT_PREFIX=[qince-backup]
ALERT_DRY_RUN=0                 # 1 = 不真正发信，把邮件全文写入 BACKUP_DIR/alerts/（演练用）
