# 复制为 .env 使用；本文件只含占位符，禁止提交真实密钥（PRD §5.11）
# 交付核对（T18）：应用运行时消费下列全部变量；POSTGRES_* 供 docker-compose*.yml
# 使用（生产见 docker-compose.prod.yml，全部 ${VAR:?} 必填）。备份/告警/加密的
# 部署侧配置不在本文件——见 scripts/backup/backup.env.example 与 docs/deploy.md。

# ---- 数据库 ----
# 应用连接串（日常开发 npm run dev 时使用；compose 环境由 compose 注入，可不用）
DATABASE_URL=postgresql://qince:CHANGE_ME@localhost:5432/qince_sales
# PostgreSQL 容器初始化（docker compose up 使用；生产必须改强口令）
POSTGRES_USER=qince
POSTGRES_PASSWORD=CHANGE_ME
POSTGRES_DB=qince_sales

# ---- 初始管理员账号（仅首次 seed 生效；生产环境必须修改默认口令）----
ADMIN_USERNAME=admin
ADMIN_NAME=管理员
ADMIN_PASSWORD=CHANGE_ME

# ---- AI 基础设施（T08）----
# 模型密钥加密主密钥（AES-256-GCM，64 位十六进制 = 32 字节；不进 Git、不进备份，§8.3）
# 生成：openssl rand -hex 32（或 node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"）
# 丢失主密钥 = 模型密钥不可解密（重新录入即可），业务数据不受影响
APP_ENCRYPTION_KEY=CHANGE_ME_64_HEX_CHARS_FROM_OPENSSL_RAND_HEX_32_AAAAAAAA

# 每用户每日 AI 调用上限（默认 50；可在设置中心调整）
AI_DAILY_LIMIT=50
